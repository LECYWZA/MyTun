# build outputs
dist/
bin/
*.exe
android/app/src/main/assets/mytun-core-*
android/app/build/
android/.gradle/
# Keep the signing key in the repo: a changing key makes every APK
# an incompatible upgrade for users. Passwords are the gradle defaults.
.keystore/*
!.keystore/mytun.jks

# runtime data
data/
*.db
*.db-shm
*.db-wal
files/

# frontend
webui/node_modules/
webui/dist/

# editor / os
.DS_Store
*.swp
.idea/
.vscode/
